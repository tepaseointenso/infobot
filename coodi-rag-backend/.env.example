PORT=8000

# --- Proveedor de IA (cualquier API compatible con OpenAI) ---
PROVIDER=openai
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1   # p.ej. Ollama local
CHAT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con el modelo de embeddings (text-embedding-3-small=1536, -large=3072).
EMBEDDING_DIM=1536

# --- Seguridad / frontend ---
# Clave para cargar/borrar documentos (header X-API-Key). Genera una con: openssl rand -hex 32
ADMIN_API_KEY=cambia-esta-clave
CORS_ORIGINS=http://localhost:4200,https://coodi.cl,https://www.coodi.cl
# URL pública del backend, usada para armar los links de imágenes en las fuentes.
PUBLIC_BASE_URL=http://localhost:8000

# --- Almacenamiento ---
DATA_DIR=./data
# Vacío = vectores en SQLite local (DATA_DIR/coodi.db). Para mucho contenido usa un servidor Qdrant:
# QDRANT_URL=http://localhost:6333
COLLECTION=coodi_knowledge

# --- Ajustes de RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
MIN_SCORE=0.25
DESCRIBE_PDF_IMAGES=true
MAX_IMAGES_PER_PDF=60
MAX_UPLOAD_MB=50
